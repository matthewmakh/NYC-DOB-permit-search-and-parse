# Database Configuration
# For local development with MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306

# For Railway deployment with PostgreSQL:
DB_TYPE=postgresql
DB_HOST=your-railway-postgres-host.railway.app
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-railway-password
DB_NAME=railway

# CRM desktop + installed iPhone Web Push (use one matching VAPID keypair)
CRM_VAPID_PUBLIC_KEY=your_public_vapid_key
CRM_VAPID_PRIVATE_KEY=your_private_vapid_key
CRM_VAPID_SUBJECT=mailto:you@example.com

# Proxy Configuration (for scrapers only, not needed for dashboard)
PROXY_HOST=gate.smartproxy.com
PROXY_PORT=7000
PROXY_USER=your_smartproxy_username
PROXY_PASS=your_smartproxy_password

# NYC Geoclient API (for geocoding permits without coordinates)
# Subscribe to Geoclient v2 at https://api-portal.nyc.gov/
NYC_GEOCLIENT_SUBSCRIPTION_KEY=your_v2_subscription_key
# Legacy variable names APP_KEY, then APP_ID, are read only if the above is unset.

# Geocoding Configuration (optional)
GEOCODE_BATCH_SIZE=100  # Number of permits to geocode per run
GEOCODE_DELAY=0.5       # Seconds between geocoding requests
